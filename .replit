modules = ["nodejs-20", "web", "python-3.11", "python3", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["alsa-lib", "at-spi2-atk", "cairo", "chromium", "cups", "dbus-glib", "expat", "freetype", "glib", "gtk3", "imagemagick", "lcms2", "libdrm", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "libxkbcommon", "mesa", "nspr", "nss", "openjpeg", "pandoc", "pango", "tcl", "tk", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "zlib"]

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "./scripts/run-tests-before-deploy.sh && npm run build"]
run = ["sh", "scripts/migrate-and-start.sh"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5904
externalPort = 3000

[[ports]]
localPort = 24678
externalPort = 3002

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
integrations = ["javascript_database:1.0.0", "javascript_log_in_with_replit:1.0.0", "javascript_stripe:1.0.0", "javascript_openai:1.0.0", "javascript_object_storage:2.0.0", "sendgrid:1.0.0", "javascript_openai_ai_integrations:2.0.0"]

[userenv]

[userenv.shared]
TESTING_VITE_STRIPE_PUBLIC_KEY = "jkadnh"
TESTING_STRIPE_SECRET_KEY = "kdsfj"

[userenv.production]
PRODUCTION_URL = "https://www.humanmetrix.co.uk"
AIRWALLEX_ENVIRONMENT = "prod"

[userenv.development]
AIRWALLEX_ENVIRONMENT = "demo"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
