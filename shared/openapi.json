{
  "openapi": "3.0.3",
  "info": {
    "title": "HumanMetrix Partner API",
    "description": "REST API for integrating HumanMetrix assessments into your recruitment platform. Create assessment sessions, retrieve results, and manage usage.",
    "version": "1.0.0",
    "contact": {
      "name": "HumanMetrix Support",
      "email": "hello@humanmetrix.co.uk"
    }
  },
  "servers": [
    {
      "url": "https://humanmetrix.co.uk",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Sessions",
      "description": "Assessment session management"
    },
    {
      "name": "Results",
      "description": "Assessment results retrieval"
    },
    {
      "name": "Usage",
      "description": "Usage and billing information"
    },
    {
      "name": "Reference",
      "description": "Reference data and metadata"
    }
  ],
  "paths": {
    "/api/partner/health": {
      "get": {
        "tags": ["Reference"],
        "summary": "Health check",
        "description": "Check API availability and status",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "timestamp": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/partner/me": {
      "get": {
        "tags": ["Reference"],
        "summary": "Get partner info",
        "description": "Retrieve authenticated partner account information",
        "operationId": "getPartnerInfo",
        "security": [{ "apiKey": [] }],
        "responses": {
          "200": {
            "description": "Partner information",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PartnerInfo" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/partner/sessions": {
      "post": {
        "tags": ["Sessions"],
        "summary": "Create assessment session",
        "description": "Create a new assessment session for a candidate. Returns a session ID and widget URL for embedding.",
        "operationId": "createSession",
        "security": [{ "apiKey": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateSessionRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "402": { "$ref": "#/components/responses/QuotaExhausted" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      },
      "get": {
        "tags": ["Sessions"],
        "summary": "List sessions",
        "description": "List all assessment sessions for your partner account",
        "operationId": "listSessions",
        "security": [{ "apiKey": [] }],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of sessions to return (max 200)",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
          }
        ],
        "responses": {
          "200": {
            "description": "List of sessions",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionListResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/partner/sessions/{sessionId}": {
      "get": {
        "tags": ["Sessions"],
        "summary": "Get session status",
        "description": "Retrieve the current status and metadata for a specific session",
        "operationId": "getSession",
        "security": [{ "apiKey": [] }],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "The session ID",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Session details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionDetails" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/partner/sessions/{sessionId}/results": {
      "get": {
        "tags": ["Results"],
        "summary": "Get session results",
        "description": "Retrieve assessment results for a completed session. Only available after the candidate completes the assessment.",
        "operationId": "getSessionResults",
        "security": [{ "apiKey": [] }],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "The session ID",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Assessment results",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResultsResponse" }
              }
            }
          },
          "400": {
            "description": "Results not available (session not completed)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/partner/usage": {
      "get": {
        "tags": ["Usage"],
        "summary": "Get usage statistics",
        "description": "Retrieve usage statistics and billing information for the current month",
        "operationId": "getUsage",
        "security": [{ "apiKey": [] }],
        "responses": {
          "200": {
            "description": "Usage statistics",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UsageResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/partner/quota": {
      "get": {
        "tags": ["Usage"],
        "summary": "Get quota balance",
        "description": "Retrieve your current prepaid test quota balance",
        "operationId": "getQuota",
        "security": [{ "apiKey": [] }],
        "responses": {
          "200": {
            "description": "Quota balance",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/QuotaResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/partner/assessment-types": {
      "get": {
        "tags": ["Reference"],
        "summary": "List assessment types",
        "description": "Get all available assessment types with descriptions and metadata",
        "operationId": "listAssessmentTypes",
        "responses": {
          "200": {
            "description": "Available assessment types",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AssessmentTypesResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key for partner authentication. Format: hm_live_xxxx or hm_test_xxxx"
      }
    },
    "schemas": {
      "CreateSessionRequest": {
        "type": "object",
        "required": ["assessmentType"],
        "properties": {
          "assessmentType": {
            "type": "string",
            "enum": ["fit", "ai_readiness", "prompt_architecture", "aiq"],
            "description": "Type of assessment to create"
          },
          "externalUserId": {
            "type": "string",
            "description": "Your internal candidate identifier"
          },
          "externalEmail": {
            "type": "string",
            "format": "email",
            "description": "Candidate's email address"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Custom metadata to attach to the session"
          },
          "webhookUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL to receive webhook notifications on session completion"
          },
          "expiresInMinutes": {
            "type": "integer",
            "minimum": 30,
            "maximum": 10080,
            "default": 1440,
            "description": "Session validity in minutes (default: 24 hours)"
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "sessionId": { "type": "string", "description": "Unique session identifier" },
          "assessmentType": { "type": "string" },
          "status": { "type": "string", "enum": ["created", "started", "completed", "expired"] },
          "expiresAt": { "type": "string", "format": "date-time" },
          "widgetUrl": { "type": "string", "format": "uri", "description": "URL for embedding the assessment" },
          "metadata": { "type": "object" }
        }
      },
      "SessionDetails": {
        "type": "object",
        "properties": {
          "sessionId": { "type": "string" },
          "assessmentType": { "type": "string" },
          "status": { "type": "string", "enum": ["created", "started", "completed", "expired"] },
          "externalUserId": { "type": "string" },
          "externalEmail": { "type": "string" },
          "metadata": { "type": "object" },
          "createdAt": { "type": "string", "format": "date-time" },
          "startedAt": { "type": "string", "format": "date-time" },
          "completedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "SessionListResponse": {
        "type": "object",
        "properties": {
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sessionId": { "type": "string" },
                "assessmentType": { "type": "string" },
                "status": { "type": "string" },
                "externalUserId": { "type": "string" },
                "createdAt": { "type": "string", "format": "date-time" },
                "completedAt": { "type": "string", "format": "date-time" }
              }
            }
          },
          "count": { "type": "integer" }
        }
      },
      "ResultsResponse": {
        "type": "object",
        "properties": {
          "sessionId": { "type": "string" },
          "assessmentType": { "type": "string" },
          "status": { "type": "string" },
          "scores": {
            "type": "object",
            "additionalProperties": { "type": "number" },
            "description": "Breakdown of scores by category"
          },
          "totalScore": { "type": "number", "description": "Overall score (0-100)" },
          "percentile": { "type": "number", "description": "Candidate's percentile ranking" },
          "evaluations": {
            "type": "object",
            "description": "Detailed AI-generated evaluations (for applicable assessments)"
          },
          "completedAt": { "type": "string", "format": "date-time" },
          "metadata": { "type": "object" }
        }
      },
      "UsageResponse": {
        "type": "object",
        "properties": {
          "period": {
            "type": "object",
            "properties": {
              "start": { "type": "string", "format": "date-time" },
              "end": { "type": "string", "format": "date-time" }
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "completedAssessments": { "type": "integer" },
              "totalBilledPence": { "type": "integer" },
              "totalBilledGBP": { "type": "string" },
              "quota": { "type": "integer" },
              "quotaUsedPercent": { "type": "string" }
            }
          },
          "breakdown": { "type": "array", "items": { "type": "object" } }
        }
      },
      "QuotaResponse": {
        "type": "object",
        "properties": {
          "testsPurchased": { "type": "integer", "description": "Total tests purchased" },
          "testsConsumed": { "type": "integer", "description": "Tests used" },
          "remaining": { "type": "integer", "description": "Tests remaining" },
          "percentageUsed": { "type": "number", "description": "Percentage of quota used" }
        }
      },
      "AssessmentTypesResponse": {
        "type": "object",
        "properties": {
          "types": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "description": { "type": "string" },
                "questionCount": { "type": "integer" },
                "estimatedMinutes": { "type": "integer" }
              }
            }
          }
        }
      },
      "PartnerInfo": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "companyName": { "type": "string" },
          "email": { "type": "string" },
          "monthlyQuota": { "type": "integer" },
          "pricePerAssessment": { "type": "integer" },
          "isActive": { "type": "boolean" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "description": "Error message" },
          "code": { "type": "string", "description": "Error code" },
          "details": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Invalid or missing API key",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": { "type": "string", "example": "Invalid or expired API key" },
                "code": { "type": "string", "example": "INVALID_API_KEY" }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": { "type": "string", "example": "Session not found" }
              }
            }
          }
        }
      },
      "ValidationError": {
        "description": "Invalid request parameters",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": { "type": "string", "example": "Validation Error" },
                "details": { "type": "array", "items": { "type": "object" } }
              }
            }
          }
        }
      },
      "QuotaExhausted": {
        "description": "Test quota exhausted",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": { "type": "string", "example": "Quota Exhausted" },
                "message": { "type": "string" },
                "quotaStatus": {
                  "type": "object",
                  "properties": {
                    "testsPurchased": { "type": "integer" },
                    "testsConsumed": { "type": "integer" },
                    "remaining": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      },
      "RateLimited": {
        "description": "Rate limit exceeded",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": { "type": "string", "example": "Rate limit exceeded" },
                "code": { "type": "string", "example": "RATE_LIMITED" },
                "retryAfter": { "type": "integer", "description": "Seconds to wait before retrying" }
              }
            }
          }
        }
      }
    }
  }
}
